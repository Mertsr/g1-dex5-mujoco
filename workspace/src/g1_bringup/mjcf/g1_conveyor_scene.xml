<mujoco model="g1_conveyor_scene">
  <!-- Mert's own world: a low workbench table a short walk from a 1.5 m roller conveyor, the
       belt feeding into an open basket at its far end, inside a room bounded by chain-link-
       style fencing on all four sides.

       A brand-new scene rather than a change to g1_manipulation_scene.xml, so nothing that
       measures against that scene (its pedestal height, its cube pose, its grasp welds)
       moves out from under it. This scene is not wired into any test or launch default; it
       exists purely for manual use.

       Every geom is group 2, matching every other scene here, so the perception sweep mask
       (which keeps a LiDAR scan from seeing only the robot's own shell) still works if this
       scene is ever driven with it.

       Staged into the vendored model directory at launch, so relative includes resolve. -->
  <include file="g1_29dof.xml"/>

  <statistic center="0.6 0 0.6" extent="3.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
      height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
      reflectance="0.2"/>
    <material name="pedestal_mat" rgba="0.35 0.38 0.42 1"/>
    <material name="belt_mat" rgba="0.12 0.12 0.12 1"/>
    <material name="roller_mat" rgba="0.75 0.77 0.80 1" specular="0.9" shininess="0.95"/>
    <material name="rail_mat" rgba="0.55 0.56 0.58 1" specular="0.5" shininess="0.6"/>
    <material name="basket_mat" rgba="0.45 0.30 0.12 1" specular="0.1" shininess="0.1"/>
    <material name="mat_part" rgba="0.85 0.55 0.1 1" specular="0.5" shininess="0.6"/>

    <!-- Stand-in for chain-link/wire-mesh fencing. MuJoCo has no wire-lattice primitive, so a
         fine checker texture at high repeat plus partial alpha is used on plain wall geoms
         instead of hundreds of individual wire-bar geoms; from any normal viewing distance it
         reads as mesh fencing rather than a solid wall, which is the point. Swap this for a
         literal bar lattice later if a close-up, physically-accurate fence ever matters. -->
    <texture type="2d" name="fence_tex" builtin="checker" mark="none" rgb1="0.55 0.56 0.58"
      rgb2="0.70 0.71 0.73" width="64" height="64"/>
    <material name="fence_mat" texture="fence_tex" texuniform="true" texrepeat="60 20"
      rgba="1 1 1 0.55" specular="0.3" shininess="0.3"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <light pos="1.2 -0.3 1.8" dir="0 0 -1" directional="true"/>
    <geom name="floor" group="2" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Perimeter fencing. A simple rectangular room, large enough that the table, belt and
         basket below (max extent roughly x -0.2..1.7, y -0.4..0.9) sit well inside it with
         room to walk the robot around. contype/conaffinity on, like real safety fencing: the
         room is a physical boundary, not just a backdrop. -->
    <geom name="fence_x_min" group="2" type="box" size="0.02 1.30 0.75" pos="-1.00 0 0.75"
      material="fence_mat" contype="1" conaffinity="1"/>
    <geom name="fence_x_max" group="2" type="box" size="0.02 1.30 0.75" pos="2.20 0 0.75"
      material="fence_mat" contype="1" conaffinity="1"/>
    <geom name="fence_y_min" group="2" type="box" size="1.60 0.02 0.75" pos="0.60 -1.30 0.75"
      material="fence_mat" contype="1" conaffinity="1"/>
    <geom name="fence_y_max" group="2" type="box" size="1.60 0.02 0.75" pos="0.60 1.30 0.75"
      material="fence_mat" contype="1" conaffinity="1"/>

    <!-- Table: lower than g1_manipulation_scene's 0.785 m pedestal (0.75 here, "a little
         lower" as asked), pushed up against the far wall (fence_x_max sits at x=2.20; the
         table's far edge at 2.17 leaves 1 cm clearance -- as snug as it goes without
         clipping) at the position Mert placed it by hand. Widened from 0.30x0.22 to
         0.34x0.40 ("a bit wider"): x is capped by the wall, so the growth is mostly in y. -->
    <geom name="table_top" group="2" type="box" size="0.34 0.40 0.015" pos="1.83 -0.80 0.735"
      material="pedestal_mat" contype="1" conaffinity="1"/>
    <geom name="table_leg_1" group="2" type="box" size="0.02 0.02 0.3675"
      pos="2.15 -1.18 0.3675" material="pedestal_mat" contype="1" conaffinity="1"/>
    <geom name="table_leg_2" group="2" type="box" size="0.02 0.02 0.3675"
      pos="2.15 -0.42 0.3675" material="pedestal_mat" contype="1" conaffinity="1"/>
    <geom name="table_leg_3" group="2" type="box" size="0.02 0.02 0.3675"
      pos="1.51 -1.18 0.3675" material="pedestal_mat" contype="1" conaffinity="1"/>
    <geom name="table_leg_4" group="2" type="box" size="0.02 0.02 0.3675"
      pos="1.51 -0.42 0.3675" material="pedestal_mat" contype="1" conaffinity="1"/>

    <!-- Roller conveyor, 1.5 m long, running along world +x (no rotation this time -- the
         basket at the far end is just "a bit further down +x", which keeps every number in
         this block in one frame instead of two). Top surface at 0.70, a little below the
         table, matching a real roller conveyor sitting lower than a workbench.

         `conveyor_belt` is the geom grove-g1's conveyor_handler.cc actually drives: a plain
         box, matched by name (exact, or `conveyor_belt_<anything>` for more than one belt).
         It is kept thin and dark rather than hidden, so it still reads as "the belt surface"
         under the rollers. The rollers themselves (below) are a visual layer on top of it and
         carry no physics of their own -- the box is what parts actually rest and drag on, so
         the drag math in conveyor_handler.cc only ever has one geom to reason about. -->
    <body name="conveyor_belt" pos="0.55 0.60 0.67" euler="0 0 0">
      <geom name="conveyor_belt" group="2" type="box" size="0.75 0.175 0.03" material="belt_mat"
        contype="1" conaffinity="1" friction="1 0.01 0.0001"/>
    </body>

    <!-- Side rails: raised guide rails along both edges, the length of the belt, both so a
         part can't wander off the side and so the conveyor reads as a conveyor rather than a
         bare plank. contype on: they are meant to contain parts, same as the real thing. -->
    <geom name="conveyor_rail_near" group="2" type="box" size="0.75 0.01 0.05"
      pos="0.55 0.415 0.75" material="rail_mat" contype="1" conaffinity="1"/>
    <geom name="conveyor_rail_far" group="2" type="box" size="0.75 0.01 0.05"
      pos="0.55 0.785 0.75" material="rail_mat" contype="1" conaffinity="1"/>

    <!-- Legs: the belt body sits at z=0.67 with half_z=0.03, so its underside is at 0.64 --
         these six stand posts (near/mid/far along the length, both rails) hold that up off
         the floor instead of leaving it floating, the way the rest of this scene's furniture
         stands on its own legs. -->
    <geom name="conveyor_leg_near_1" group="2" type="box" size="0.03 0.03 0.32"
      pos="-0.15 0.425 0.32" material="rail_mat" contype="1" conaffinity="1"/>
    <geom name="conveyor_leg_near_2" group="2" type="box" size="0.03 0.03 0.32"
      pos="-0.15 0.775 0.32" material="rail_mat" contype="1" conaffinity="1"/>
    <geom name="conveyor_leg_mid_1" group="2" type="box" size="0.03 0.03 0.32"
      pos="0.55 0.425 0.32" material="rail_mat" contype="1" conaffinity="1"/>
    <geom name="conveyor_leg_mid_2" group="2" type="box" size="0.03 0.03 0.32"
      pos="0.55 0.775 0.32" material="rail_mat" contype="1" conaffinity="1"/>
    <geom name="conveyor_leg_far_1" group="2" type="box" size="0.03 0.03 0.32"
      pos="1.25 0.425 0.32" material="rail_mat" contype="1" conaffinity="1"/>
    <geom name="conveyor_leg_far_2" group="2" type="box" size="0.03 0.03 0.32"
      pos="1.25 0.775 0.32" material="rail_mat" contype="1" conaffinity="1"/>

    <!-- Discharge ramp: a second, angled belt segment rather than a bare edge at x=1.30.
         Parts used to stop dead right at that edge -- the conveyor force cuts out exactly
         when a part's centre crosses it, but its trailing half was still resting on the flat
         box, so it balanced there in near-equilibrium for 30-60 (simulated) seconds before
         gravity alone finally tipped it off. A named `conveyor_belt_*` geom is not special
         cased in conveyor_handler.cc -- resolve() finds every belt by the same prefix match
         and run() drags a body along WHICHEVER matching belt it's currently over, using that
         belt's own pose for direction -- so this ramp is simply a second belt, angled 40 deg
         down towards the basket, that keeps actively pushing (now down-and-forward along its
         own tilted local +x) right through the transition instead of leaving it to a
         knife-edge balance. Overlaps 3 cm back under the flat belt (its near edge sits at
         x=1.27, not 1.30) so there is no geometric seam for a part to hang up on.
         Checked standalone: the same stall that used to take 30-60 s now clears in about
         10 s, and the part lands flat (not teetering) in the basket. -->
    <body name="conveyor_belt_ramp" pos="1.36 0.60 0.6245" euler="0 40 0">
      <geom name="conveyor_belt_ramp" group="2" type="box" size="0.1175 0.175 0.03"
        material="belt_mat" contype="1" conaffinity="1" friction="1 0.01 0.0001"/>
    </body>

    <!-- 14 rollers across the 1.5 m length, visual only (contype 0 -- the belt box under them
         carries the actual contact). Each is a cylinder laid across the belt's width with
         `fromto`, rather than a body + default z-aligned cylinder, so there is no per-roller
         orientation to get wrong. Radius trimmed from an earlier 0.025 to 0.012: the physical
         support is always the flat belt box at 0.70 regardless of roller size, so a bigger
         radius just means a deeper visible gap between where a part actually rests (0.70) and
         the rollers' own crest -- parts looked sunk a full 5 cm below the rollers. At 0.012
         that gap is 2.4 cm, flush enough to read as "resting on the rollers" rather than
         "recessed in a slot". -->
    <geom name="roller_01" group="2" type="cylinder" size="0.012" material="roller_mat"
      fromto="-0.125 0.445 0.712  -0.125 0.755 0.712" contype="0" conaffinity="0"/>
    <geom name="roller_02" group="2" type="cylinder" size="0.012" material="roller_mat"
      fromto="-0.025 0.445 0.712  -0.025 0.755 0.712" contype="0" conaffinity="0"/>
    <geom name="roller_03" group="2" type="cylinder" size="0.012" material="roller_mat"
      fromto="0.075 0.445 0.712  0.075 0.755 0.712" contype="0" conaffinity="0"/>
    <geom name="roller_04" group="2" type="cylinder" size="0.012" material="roller_mat"
      fromto="0.175 0.445 0.712  0.175 0.755 0.712" contype="0" conaffinity="0"/>
    <geom name="roller_05" group="2" type="cylinder" size="0.012" material="roller_mat"
      fromto="0.275 0.445 0.712  0.275 0.755 0.712" contype="0" conaffinity="0"/>
    <geom name="roller_06" group="2" type="cylinder" size="0.012" material="roller_mat"
      fromto="0.375 0.445 0.712  0.375 0.755 0.712" contype="0" conaffinity="0"/>
    <geom name="roller_07" group="2" type="cylinder" size="0.012" material="roller_mat"
      fromto="0.475 0.445 0.712  0.475 0.755 0.712" contype="0" conaffinity="0"/>
    <geom name="roller_08" group="2" type="cylinder" size="0.012" material="roller_mat"
      fromto="0.575 0.445 0.712  0.575 0.755 0.712" contype="0" conaffinity="0"/>
    <geom name="roller_09" group="2" type="cylinder" size="0.012" material="roller_mat"
      fromto="0.675 0.445 0.712  0.675 0.755 0.712" contype="0" conaffinity="0"/>
    <geom name="roller_10" group="2" type="cylinder" size="0.012" material="roller_mat"
      fromto="0.775 0.445 0.712  0.775 0.755 0.712" contype="0" conaffinity="0"/>
    <geom name="roller_11" group="2" type="cylinder" size="0.012" material="roller_mat"
      fromto="0.875 0.445 0.712  0.875 0.755 0.712" contype="0" conaffinity="0"/>
    <geom name="roller_12" group="2" type="cylinder" size="0.012" material="roller_mat"
      fromto="0.975 0.445 0.712  0.975 0.755 0.712" contype="0" conaffinity="0"/>
    <geom name="roller_13" group="2" type="cylinder" size="0.012" material="roller_mat"
      fromto="1.075 0.445 0.712  1.075 0.755 0.712" contype="0" conaffinity="0"/>
    <geom name="roller_14" group="2" type="cylinder" size="0.012" material="roller_mat"
      fromto="1.175 0.445 0.712  1.175 0.755 0.712" contype="0" conaffinity="0"/>

    <!-- Basket at the belt's discharge end (belt's far edge is at x = 0.55 + 0.75 = 1.30).
         Open on the belt-facing side on purpose: conveyor_handler.cc stops dragging a part the
         instant it crosses the belt box's own edge, so from there it is a short, nearly-flat
         toss off the end -- a facing wall would just be something for it to clip on the way
         in. Floor sits 0.29 m below the belt top, which is enough drop that a part lands
         inside rather than skimming the lip. -->
    <geom name="basket_floor" group="2" type="box" size="0.18 0.20 0.01" pos="1.48 0.60 0.40"
      material="basket_mat" contype="1" conaffinity="1"/>
    <geom name="basket_wall_far" group="2" type="box" size="0.01 0.20 0.15" pos="1.66 0.60 0.56"
      material="basket_mat" contype="1" conaffinity="1"/>
    <geom name="basket_wall_near" group="2" type="box" size="0.18 0.01 0.15" pos="1.48 0.41 0.56"
      material="basket_mat" contype="1" conaffinity="1"/>
    <geom name="basket_wall_far2" group="2" type="box" size="0.18 0.01 0.15" pos="1.48 0.79 0.56"
      material="basket_mat" contype="1" conaffinity="1"/>

    <!-- The basket's own floor sits at z=0.40, same floating-furniture issue the belt had --
         these two posts hold it up rather than leaving it hanging. -->
    <geom name="basket_leg_1" group="2" type="box" size="0.025 0.025 0.195"
      pos="1.33 0.44 0.195" material="basket_mat" contype="1" conaffinity="1"/>
    <geom name="basket_leg_2" group="2" type="box" size="0.025 0.025 0.195"
      pos="1.63 0.76 0.195" material="basket_mat" contype="1" conaffinity="1"/>

    <!-- Three copies of one part, staged at the belt's near (table) end rather than on the
         table, so the belt starts dragging them towards the basket as soon as the sim comes
         up -- "parts fall into the basket" needs them on the belt, not waiting to be placed
         there. Placeholder pucks until the real part file is in hand; only the geom changes
         when it arrives, nothing about the belt or basket math cares what shape is on it.

         Short and wide (half-height 0.010, half-footprint 0.045) rather than the 0.025 cube
         this started as: conveyor_handler.cc's drag force lands at the body's own origin, at
         whatever height that is, while the belt's friction reaction acts down at the contact
         plane -- the same lever-arm effect that tips a filing cabinet pushed at its middle
         rather than its base. A tall cube's CoM sits far enough above the belt for that
         torque to tip it end over end; a squat, wide puck's CoM barely clears the belt, so
         the same push stays a push, not a tip, and it rides the belt flat the whole way
         (checked standalone: a 0.025 cube drifted to a ~130 deg tumble under this force,
         the 0.045x0.045x0.010 puck settled under 0.1 deg of rotation).

         Rest height is 0.01 above the belt box's 0.70 top (its own half-height, not the
         rollers'; the pucks are low enough to clear the roller bumps without resting on
         them). Spread across the belt's width so they don't collide with each other
         immediately.

         A small amount of joint damping (0.5, on a free joint applying to all six dofs, not
         just rotation) is layered on top of the squat shape: on the full 1.5 m run a rail
         nudge or roller-height bump could still start a slow spin even with the lowered CoM
         (measured up to ~23 deg over the run without this). At this belt's speed the damping
         cuts steady-state travel speed by under 2% (checked: ~0.079 vs the configured 0.08
         m/s) while holding peak in-transit rotation under 0.1 deg. -->
    <body name="part_1" pos="-0.10 0.50 0.71">
      <joint type="free" name="part_1_joint" damping="0.5"/>
      <geom group="2" type="box" size="0.045 0.045 0.010" material="mat_part" mass="0.05"
        contype="1" conaffinity="1" friction="1 0.01 0.0001"/>
    </body>
    <body name="part_2" pos="0.00 0.60 0.71">
      <joint type="free" name="part_2_joint" damping="0.5"/>
      <geom group="2" type="box" size="0.045 0.045 0.010" material="mat_part" mass="0.05"
        contype="1" conaffinity="1" friction="1 0.01 0.0001"/>
    </body>
    <body name="part_3" pos="0.10 0.70 0.71">
      <joint type="free" name="part_3_joint" damping="0.5"/>
      <geom group="2" type="box" size="0.045 0.045 0.010" material="mat_part" mass="0.05"
        contype="1" conaffinity="1" friction="1 0.01 0.0001"/>
    </body>

    <!-- Carried over from the other scenes for the same reason: the sensor sampler writes
         this camera's pose from torso_link every frame, since the vendored mount can't host
         one of its own. -->
    <camera name="d435i" mode="fixed" fovy="58" resolution="848 480" pos="0 0 1"/>
  </worldbody>
</mujoco>

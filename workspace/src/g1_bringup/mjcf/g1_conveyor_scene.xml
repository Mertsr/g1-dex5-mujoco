<mujoco model="g1_conveyor_scene">
  <!-- Mert's own world: a workbench table in front of the robot, a conveyor belt beside it,
       and three copies of one part sitting on the table.

       A brand-new scene rather than a change to g1_manipulation_scene.xml, so nothing that
       measures against that scene (its pedestal height, its cube pose, its grasp welds)
       moves out from under it. This scene is not wired into any test or launch default; it
       exists purely for manual use.

       Every geom is group 2, matching every other scene here, so the perception sweep mask
       (which keeps a LiDAR scan from seeing only the robot's own shell) still works if this
       scene is ever driven with it.

       Staged into the vendored model directory at launch, so relative includes resolve. -->
  <include file="g1_29dof.xml"/>

  <statistic center="0 0 0.5" extent="2.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
      height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
      reflectance="0.2"/>
    <material name="pedestal_mat" rgba="0.35 0.38 0.42 1"/>
    <material name="belt_mat" rgba="0.12 0.12 0.12 1"/>
    <material name="mat_part" rgba="0.85 0.55 0.1 1" specular="0.5" shininess="0.6"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" group="2" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Table: same 0.75 m-ish workbench height convention as g1_manipulation_scene, near
         edge clear of the spawned arm the same way (x 0.26, 8 cm past where the right palm
         hangs at spawn). Top at 0.80, legs centred under the corners. -->
    <geom name="table_top" group="2" type="box" size="0.30 0.22 0.015" pos="0.56 -0.10 0.785"
      material="pedestal_mat" contype="1" conaffinity="1"/>
    <geom name="table_leg_near" group="2" type="box" size="0.02 0.02 0.385"
      pos="0.84 -0.30 0.385" material="pedestal_mat" contype="1" conaffinity="1"/>
    <geom name="table_leg_far" group="2" type="box" size="0.02 0.02 0.385"
      pos="0.84 0.10 0.385" material="pedestal_mat" contype="1" conaffinity="1"/>
    <geom name="table_leg_near2" group="2" type="box" size="0.02 0.02 0.385"
      pos="0.28 -0.30 0.385" material="pedestal_mat" contype="1" conaffinity="1"/>
    <geom name="table_leg_far2" group="2" type="box" size="0.02 0.02 0.385"
      pos="0.28 0.10 0.385" material="pedestal_mat" contype="1" conaffinity="1"/>

    <!-- Conveyor belt: a static box beside the table, its own frame rotated 90 deg about z so
         its local +x (the drag direction conveyor_handler.cc reads from its pose) runs
         roughly parallel to the table's near edge, feeding past it. Top surface at the same
         0.80 as the table, so a part dragged off the table and onto the belt doesn't fall
         before it's picked up by the drag zone, and vice versa.

         `conveyor_belt` is a naming-convention match, not a hardcoded id: grove-g1's
         conveyor_handler.cc (workspace/vendor/unitree_mujoco/) discovers any geom named
         exactly this or `conveyor_belt_<anything>` and drives free bodies resting on it,
         purely from GROVE_G1_SENSOR_CONFIG's `conveyor:` section -- see sim_sensors.yaml. -->
    <body name="conveyor_belt" pos="0.56 -0.55 0.75" euler="0 0 90">
      <geom name="conveyor_belt" group="2" type="box" size="0.45 0.14 0.05" material="belt_mat"
        contype="1" conaffinity="1" friction="1 0.01 0.0001"/>
    </body>

    <!-- Three copies of one part on the table. Placeholder boxes until the real part file is
         in hand -- geometry only, swap the geom (and, if it stops being a box, resolve() in
         conveyor_handler.cc doesn't care, since only the belt geom itself must stay a box)
         once it arrives. Spawned at rest height (half-height 0.025 above the 0.80 top) so
         they settle instead of bouncing, spaced along the table's reachable near edge. -->
    <body name="part_1" pos="0.42 -0.14 0.825">
      <freejoint name="part_1_joint"/>
      <geom group="2" type="box" size="0.025 0.025 0.025" material="mat_part" mass="0.05"
        contype="1" conaffinity="1" friction="1 0.01 0.0001"/>
    </body>
    <body name="part_2" pos="0.56 -0.14 0.825">
      <freejoint name="part_2_joint"/>
      <geom group="2" type="box" size="0.025 0.025 0.025" material="mat_part" mass="0.05"
        contype="1" conaffinity="1" friction="1 0.01 0.0001"/>
    </body>
    <body name="part_3" pos="0.70 -0.14 0.825">
      <freejoint name="part_3_joint"/>
      <geom group="2" type="box" size="0.025 0.025 0.025" material="mat_part" mass="0.05"
        contype="1" conaffinity="1" friction="1 0.01 0.0001"/>
    </body>

    <!-- Carried over from the other scenes for the same reason: the sensor sampler writes
         this camera's pose from torso_link every frame, since the vendored mount can't host
         one of its own. -->
    <camera name="d435i" mode="fixed" fovy="58" resolution="848 480" pos="0 0 1"/>
  </worldbody>
</mujoco>

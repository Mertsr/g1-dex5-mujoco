# Pick a known object off a surface: with one arm, and for a scoop optionally the other hand too.
#
# The pose is not a goal field: the server reads it from /objects when the goal starts, so a
# retry re-reads it rather than replaying a stale one. A goal for an object that is missing or
# stale on that topic is rejected, never guessed at.

# Must match a class_id published on /objects.
string object_id
# "left" or "right". Selects the arm group, its hand group and the palm to attach to. "auto"
# takes the hand on the side the grasp point is on (pelvis frame).
string ARM_LEFT=left
string ARM_RIGHT=right
string ARM_AUTO=auto
string arm
# How many hands hold the part, for grasps that can take a second hand (the scoops). 0: the
# server's default (its scoop_two_hand parameter); 1: the gripping hand alone; 2: the other
# hand takes the part's other half too. A 2 the scene cannot give still ends held in one hand,
# and the result message says so.
uint8 HANDS_DEFAULT=0
uint8 HANDS_ONE=1
uint8 HANDS_TWO=2
uint8 hands
---
bool success
# On failure, names the phase that failed and why. Not meant to be parsed.
string message
---
# Which phase is running. Also what the result message names on failure, so the constants are
# here rather than duplicated as literals in the server and its tests.
string PHASE_LOCATING=locating
string PHASE_PREGRASP=pregrasp
string PHASE_APPROACH=approach
string PHASE_GRASP=grasp
string PHASE_LIFT=lift
string phase
